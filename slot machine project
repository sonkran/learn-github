import random


def top_up():
    while True:
        balance = input("Top up: ")
        if not balance.isdigit():
            print("Enter a valid number")
            continue
        
        balance = int(balance)

        if balance <= 0:
            print("The top-up amount must be greater than 0")
        else:
            return balance
        

def bet():
    while True:
        bet = input("Bet: ")
        if not bet.isdigit():
            print("Enter a valid number")
            continue
        
        bet = int(bet)

        if bet <= 0:
            print("The bet must be greater than 0")
        else:
            return bet


def spin_row():
    symbols = ["2", "3", "4", "5", "6", "7"]
    return [random.choice(symbols) for _ in range(3)]


def print_row(row):
    row_display = " | ".join(row)
    print(row_display)


def payout(play_bet, row):
    if row[0] == row[1] == row[2]:

        if row[0] == "2":
            print(f"You won {play_bet * 7}$!")
            return play_bet * 7
        
        elif row[0] == "3":
            print(f"You won {play_bet * 10}$!")
            return play_bet * 10
        
        elif row[0] == "4":
            print(f"You won {play_bet * 13}$!")
            return play_bet * 13
        
        elif row[0] == "5":
            print(f"You won {play_bet * 17}$!")
            return play_bet * 17
        
        elif row[0] == "6":
            print(f"You won {play_bet * 25}$!")
            return play_bet * 25
        
        elif row[0] == "7":
            print(f"You won {play_bet * 45}$!")
            return play_bet * 45

    else:
        print(f"You lost {play_bet}$.")
        return 0
        

def main():
    balance = top_up()

    while balance > 0:
        print(f"Your balance is {balance}$.")
        play_bet = bet()

        if play_bet > balance:
            print("Your balance is not enough.")
            continue
        
        balance -= play_bet

        row = spin_row()
        print_row(row)

        get_payout = payout(play_bet, row)
        balance += get_payout


if __name__ == "__main__":
    main()
